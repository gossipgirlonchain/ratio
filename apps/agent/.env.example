# Copy to .env (gitignored) and fill in. The real XClient reads exactly
# these names; the sims never touch them.

# --- X API (developer portal: Keys and tokens) ------------------------------
# App-only bearer, OAuth 2.0 — reads: mention polling, tweet lookups,
# like counts for the sampler.
X_BEARER_TOKEN=

# Consumer keys, OAuth 1.0a ("API Key and Secret" in the portal).
X_API_KEY=
X_API_SECRET=

# The BOT ACCOUNT's access token + secret, OAuth 1.0a ("Access Token and
# Secret", generated while logged in as the bot; must say Read and Write).
# These are what post cards, confirmations, and recaps.
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- identity ---------------------------------------------------------------
# The bot's handle, no @. Drives copy and mention matching everywhere.
RATIO_BOT_HANDLE=

# --- Privy (server wallets keyed on numeric X id) ---------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Supabase (project "ratio", ref zgigulklkoaihqunhefu) -------------------
SUPABASE_URL=
# service role key: dashboard -> project settings -> API keys. WRITES.
# The agent must have it; never ships to a client.
SUPABASE_SERVICE_KEY=
# publishable key: safe for clients, reads through RLS.
SUPABASE_PUBLISHABLE_KEY=

# --- Solana -----------------------------------------------------------------
# Also read from the repo-root .env by the devnet scripts; the deployed
# agent sets them here.
SOLANA_RPC_URL=
SOLANA_WS_URL=
