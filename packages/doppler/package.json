{
  "name": "@ratio/doppler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for ratio's pair markets on Doppler (doppler-sol, prediction migrator).",
  "exports": {
    "./pair-market": "./src/pairMarket.ts",
    "./tx": "./src/tx.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "e2e": "tsx --env-file-if-exists=../../.env scripts/e2e-devnet.ts",
    "sell-size": "tsx --env-file-if-exists=../../.env scripts/e2e-sell-size.ts",
    "hook-gating": "tsx --env-file-if-exists=../../.env scripts/e2e-hook-gating.ts"
  },
  "dependencies": {
    "@solana-program/system": "^0.12.2",
    "@solana-program/token": "^0.12.0",
    "@solana/kit": "^6.10.0",
    "@solana/sysvars": "^6.10.0",
    "@whetstone-research/doppler-sdk": "^1.0.37"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.1",
    "typescript": "5.5.3"
  }
}
